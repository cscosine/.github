{
  "org": "cscosine",
  "upstream_versioned": ["csqt6", "csopencvcpu", "csopencvcuda"],
  "outside_template": ["cs-project-template", "cs-pre-commit-hooks"],
  "groups": [
    {
      "name": "Tooling",
      "repos": [
        {"repo": "csCMake", "workflow": "ci.yml"},
        {"repo": "csorchestrator", "workflow": "ci.yml"},
        {"repo": "cs-project-template", "what": "Copier template: the shared files and rules of every repository, created and kept up to date", "workflow": "ci.yml"},
        {"repo": "cs-pre-commit-hooks", "what": "pre-commit hooks of every repository: gersemi with the csCMake signatures, cscmake-lint", "workflow": "ci.yml"}
      ]
    },
    {
      "name": "Foundations",
      "repos": [
        {"repo": "third_party_base_libs", "builds": ["eigen3", "fmt", "cpptrace", "libassert", "magic_enum", "Catch2", "tl-expected", "tl-optional", "NamedType", "tclap", "fmt-eigen"]},
        {"repo": "csqt6"},
        {"repo": "csopencvcpu", "builds": ["opencv", "opencv_contrib"]},
        {"repo": "csfoundation", "builds": ["csCore", "csLie", "csCamera", "csVisOpenGL"]},
        {"repo": "csoptimization", "builds": ["csNelson", "csBlockMatrix"]}
      ]
    },
    {
      "name": "Applications",
      "repos": [
        {"repo": "csImgTracker"},
        {"repo": "csSkiTracker"}
      ]
    }
  ]
}
